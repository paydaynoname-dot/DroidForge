<Window x:Class="DroidForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DroidForge" Height="880" Width="1460" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#080B12" Foreground="#F1F4FA"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Base" Color="#080B12"/>
        <SolidColorBrush x:Key="Panel" Color="#101520"/>
        <SolidColorBrush x:Key="Panel2" Color="#151C29"/>
        <SolidColorBrush x:Key="Line" Color="#222B3A"/>
        <SolidColorBrush x:Key="Muted" Color="#8B97A9"/>
        <SolidColorBrush x:Key="Mint" Color="#70F0C0"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Background" Value="#192130"/>
            <Setter Property="BorderBrush" Value="#263247"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#06120F"/><Setter Property="Background" Value="#70F0C0"/><Setter Property="BorderBrush" Value="#70F0C0"/><Setter Property="Padding" Value="19,12"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#A5B0C2"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Background" Value="#0B1019"/><Setter Property="BorderBrush" Value="#2A3548"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Background" Value="#0B1019"/><Setter Property="BorderBrush" Value="#2A3548"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="Background" Value="#111722"/><Setter Property="Padding" Value="8,5"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CFD6E2"/><Setter Property="Margin" Value="0,7,0,7"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0B0F17" BorderBrush="#1D2634" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,4,0,34">
                        <Border Width="34" Height="34" CornerRadius="11" Background="#70F0C0"><TextBlock Text="D" Foreground="#07130F" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="DROIDFORGE" FontSize="14" FontWeight="Bold"/><TextBlock Text="ANDROID DESKTOP" FontSize="9" Foreground="#77849A" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="#758197" Margin="11,0,0,12"/>
                    <Button x:Name="NavHome" Style="{StaticResource NavButton}" Click="NavHome_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="27"/><TextBlock Text="Главная" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavDevices" Style="{StaticResource NavButton}" Click="NavDevices_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="16" Width="27"/><TextBlock Text="Мои устройства" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavApps" Style="{StaticResource NavButton}" Click="NavApps_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="16" Width="27"/><TextBlock Text="Приложения" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="27"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="2,0,2,0">
                    <Border Height="1" Background="#202837" Margin="0,0,0,14"/>
                    <Border Background="#111823" BorderBrush="#202A39" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#F7BD67" Margin="0,0,8,0"/><TextBlock x:Name="SidebarStatus" Text="Поиск Android SDK" FontSize="11" Foreground="#C0C9D7"/></StackPanel><TextBlock x:Name="SidebarDevice" Text="Подключите Android SDK" FontSize="10" Foreground="#77849A" Margin="15,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                    <TextBlock Text="DROIDFORGE  ·  0.1.3" FontSize="9" Foreground="#596578" Margin="11,14,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="36,27,36,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel><TextBlock x:Name="PageEyebrow" Text="ANDROID НА КОМПЬЮТЕРЕ" Foreground="#70F0C0" FontSize="10"/><TextBlock x:Name="PageTitle" Text="Твоя игровая платформа" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border x:Name="SdkBadge" CornerRadius="15" Background="#151D29" BorderBrush="#263244" BorderThickness="1" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse x:Name="SdkDot" Width="7" Height="7" Fill="#F7BD67" Margin="0,0,8,0"/><TextBlock x:Name="SdkBadgeText" Text="SDK не найден" FontSize="11" Foreground="#BDC7D5"/></StackPanel></Border><Button Content="Обновить" Margin="10,0,0,0" Padding="12,8" Click="Refresh_Click"/></StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageHost"/></ScrollViewer>
        </Grid>
    </Grid>
</Window>
